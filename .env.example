# Server Configuration
PORT=5050
NODE_ENV=development

# Database Configuration (SQLite default)
DATABASE_URL="file:./prisma/dev.db"

# Meta Graph API Credentials (Optional - for EU/UK commercial ads or political ads)
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION="v20.0"

# Instagram Graph API Credentials (Optional - requires approved Business Account)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# Third-Party Discovery Providers (Optional)
# SearchApi key for Meta Ad Library engine
SEARCHAPI_API_KEY=
# Apify token for Instagram Reels actors
APIFY_TOKEN=

# AI & Embedding Services (Optional - fallback to local embeddings)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Discovery Configuration
MAX_DISCOVERY_RESULTS=20
SIMILARITY_MATCH_THRESHOLD=0.65
